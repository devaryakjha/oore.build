{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash ../../tools/sync-install-scripts.sh && portless run --name oore astro dev",
    "dev:legacy": "bash ../../tools/sync-install-scripts.sh && astro dev --port 3002",
    "build": "bash ../../tools/sync-install-scripts.sh && astro build",
    "preview": "bash ../../tools/sync-install-scripts.sh && astro preview --port 3002",
    "test": "node --test tests/site-sanity.test.mjs",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "node --test tests/site-sanity.test.mjs && oxfmt --check . && oxlint --type-aware .",
    "fix": "oxfmt . && oxlint --type-aware --fix ."
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/react": "^5.0.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.1",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}
