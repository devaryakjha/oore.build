{
  "name": "docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "bun run check:redirects && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "preview:production": "wrangler pages dev dist --compatibility-date 2026-07-15 --ip 127.0.0.1 --port 4173 --log-level error --show-interactive-dev-session=false",
    "docs:dev": "portless run --name docs.oore astro dev",
    "docs:dev:legacy": "astro dev --port 4173",
    "docs:build": "bun run check:redirects && astro build",
    "docs:preview": "astro preview --host 127.0.0.1 --port 4173",
    "types:check": "astro check",
    "test": "bun run test:source",
    "test:source": "vitest run --config vitest.config.ts tests/docs-sanity.test.ts && bun scripts/acceptance-attestation.ts source",
    "test:editorial": "bun scripts/verify-editorial-review.ts",
    "test:build": "vitest run --config vitest.config.ts tests/static-output.test.ts && bun scripts/acceptance-attestation.ts build",
    "test:browser": "playwright test --config playwright.config.ts && bun scripts/acceptance-attestation.ts browser",
    "generate:redirects": "bun scripts/generate-redirects.ts",
    "check:redirects": "bun scripts/generate-redirects.ts --check",
    "check:examples": "bun scripts/validate-examples.ts",
    "artifact:manifest": "bun scripts/artifact-manifest.ts",
    "lint": "astro sync && oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt --check . && astro sync && oxlint --type-aware . && bun run types:check",
    "fix": "oxfmt . && astro sync && oxlint --type-aware --fix ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@orama/orama": "^3.1.18",
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.13.0",
    "fumadocs-openapi": "11.2.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.13.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "6.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "7.1.6",
    "oxlint": "1.73.0",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  }
}
