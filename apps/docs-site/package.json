{
  "name": "docs-site",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && bun ../../tools/materialize-docs-static-assets.ts",
    "preview": "serve .output/public --config ../../serve.json --listen 4173 --no-clipboard",
    "docs:dev": "portless run --name docs.oore vite dev",
    "docs:dev:legacy": "vite dev --port 4173",
    "docs:build": "vite build && bun ../../tools/materialize-docs-static-assets.ts",
    "docs:preview": "serve .output/public --config ../../serve.json --listen 4173 --no-clipboard",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt --check . && oxlint --type-aware . && bun run types:check",
    "fix": "oxfmt . && oxlint --type-aware --fix ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@orama/orama": "^3.1.18",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/start-static-server-functions": "1.167.19",
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.13.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-openapi": "11.2.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.13.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "nitro": "3.0.260610-beta",
    "oxlint": "1.73.0",
    "serve": "^14.2.6",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
