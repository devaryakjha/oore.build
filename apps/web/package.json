{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "dev:demo": "VITE_DEMO_MODE=true vite --port 3000",
    "build": "vite build && tsc",
    "bundle:check": "node tools/check-bundle-budget.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:ui:scheduled": "playwright test --config=playwright.scheduled.config.ts",
    "performance:browser:prototype": "OORE_PERF_PROFILE=local playwright test --config=playwright.performance.config.ts",
    "performance:browser:prototype:pr": "OORE_PERF_PROFILE=pr playwright test --config=playwright.performance.config.ts",
    "performance:browser:prototype:scheduled": "OORE_PERF_PROFILE=scheduled playwright test --config=playwright.performance.config.ts",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt --check . && oxlint --type-aware .",
    "fix": "oxfmt . && oxlint --type-aware --fix .",
    "knip": "knip"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.5.7",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@mswjs/interceptors": "^0.41.9",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.0.8",
    "date-fns": "^4.4.0",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.83.0",
    "react-markdown": "^10.1.0",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "msw": "^2.15.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.73.0",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "web-vitals": "^5.3.0"
  }
}
