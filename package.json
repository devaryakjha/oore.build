{
  "name": "oore-build",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && bun run dev",
    "dev:docs": "cd apps/docs && bun run docs:dev",
    "dev:site": "cd apps/site && bun run dev",
    "generate:og": "bun tools/generate-og-images.tsx",
    "build:web": "bun run generate:og && cd apps/web && bun run build",
    "bundle:check": "cd apps/web && bun run bundle:check",
    "build:docs": "bun run generate:og && cd apps/docs && bun run docs:build",
    "build:site": "bun run generate:og && cd apps/site && bun run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "check": "bun run format:check && bun run lint"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.13.0",
    "h3-v2": "npm:h3@2.0.1-rc.20",
    "oxfmt": "0.59.0",
    "oxlint": "1.73.0",
    "oxlint-tailwindcss": "^1.3.5",
    "oxlint-tsgolint": "0.24.0",
    "react": "19.2.7",
    "satori": "0.29.0",
    "wrangler": "4.110.0"
  }
}
